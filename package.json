{
  "name": "superboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "mathjax": "node scripts/copy-mathjax.mjs",
    "dev": "npm run mathjax && vite",
    "build:viewer": "npm run mathjax && vite build",
    "build:site": "npm run build:viewer && node web/build.js",
    "preview:site": "vite preview --outDir dist",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed-board.ts"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "hast-util-sanitize": "^5.0.2",
    "mathjax": "^4.1.3",
    "pele": "^1.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-useanimations": "^3.1.1",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tldraw": "^5.6.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
