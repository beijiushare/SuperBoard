{
  "name": "superboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "patch-package && node scripts/clear-vite-cache.mjs",
    "clear:vite": "node scripts/clear-vite-cache.mjs",
    "mathjax": "node scripts/copy-mathjax.mjs",
    "pele:sizes": "node scripts/build-pele-sizes.mjs",
    "dev": "npm run mathjax && npm run pele:sizes && vite",
    "build:viewer": "npm run mathjax && npm run pele:sizes && vite build --mode viewer",
    "build:editor": "npm run mathjax && npm run pele:sizes && vite build --mode editor",
    "build:site": "node scripts/export-site.mjs --data info/public --out dist-info",
    "build:info": "node scripts/export-site.mjs --data info/public --out dist-info",
    "build:data": "node scripts/export-site.mjs --data whiteboards/public --out dist-data --base /",
    "export:site": "node scripts/export-site.mjs",
    "preview:site": "vite preview --outDir dist",
    "desktop:dev": "cd desktop && wails3 dev",
    "desktop:build": "cd desktop && wails3 build",
    "desktop:package": "cd desktop && wails3 package",
    "prepare:canvas": "tsx scripts/prepare-canvas.ts",
    "typecheck": "tsc --noEmit",
    "test:model": "tsx scripts/test-canvas-model.ts",
    "test:editor": "tsx scripts/test-canvas-editor.ts"
  },
  "dependencies": {
    "@ahmedsemih/color-fns": "^1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fullcalendar/react": "^7.1.5",
    "@needle-di/core": "^1.2.1",
    "@wailsio/runtime": "^3.0.0",
    "dompurify": "^3.4.17",
    "hast-util-sanitize": "^5.0.2",
    "marked": "^18.2.0",
    "mathjax": "^4.1.3",
    "pele": "^1.13.0",
    "perfect-freehand": "^1.2.3",
    "pointeract": "^1.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "temporal-polyfill": "^1.0.8",
    "unist-util-visit": "^5.0.0",
    "vditor": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "patch-package": "^8.0.1",
    "sass": "^1.108.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
