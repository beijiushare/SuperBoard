{
  "name": "superboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "mathjax": "node scripts/copy-mathjax.mjs",
    "dev": "npm run mathjax && vite",
    "build:viewer": "npm run mathjax && vite build",
    "build:site": "npm run prepare:canvas && npm run build:viewer && node web/build.js",
    "preview:site": "vite preview --outDir dist",
    "prepare:canvas": "tsx scripts/prepare-canvas.ts",
    "typecheck": "tsc --noEmit",
    "test:model": "tsx scripts/test-canvas-model.ts",
    "test:migration": "tsx scripts/test-tldraw-migration.ts",
    "convert:canvas": "tsx scripts/convert-boards.ts",
    "seed": "tsx scripts/seed-board.ts"
  },
  "dependencies": {
    "@ahmedsemih/color-fns": "^1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@needle-di/core": "^1.2.1",
    "dompurify": "^3.4.17",
    "hast-util-sanitize": "^5.0.2",
    "marked": "^18.2.0",
    "mathjax": "^4.1.3",
    "pele": "^1.13.0",
    "perfect-freehand": "^1.2.3",
    "pointeract": "^1.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-useanimations": "^3.1.1",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tldraw": "^5.6.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "sass": "^1.108.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
